# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -e

# OS specific support.
cygwin=false
darwin=false
mingw=false
msys=false
case "$(uname)" in
  CYGWIN*) cygwin=true ;;
  MINGW*)  mingw=true  ;;
  MSYS*)   msys=true   ;;
  Darwin*) darwin=true ;;
esac

# Attempt to set APP_HOME
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_HOME="$SCRIPT_DIR"

# Read wrapper properties
MAVEN_PROJECTBASEDIR="$APP_HOME"
MAVEN_WRAPPER_PROPERTIES="$APP_HOME/.mvn/wrapper/maven-wrapper.properties"

if [ -r "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep "^distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2- | tr -d '[:space:]')
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_DIR="$MAVEN_USER_HOME/wrapper"
mkdir -p "$MAVEN_WRAPPER_DIR"

# Derive distribution name and path from URL
DISTRIBUTION_FILE="${DISTRIBUTION_URL##*/}"
DISTRIBUTION_NAME="${DISTRIBUTION_FILE%.zip}"
DISTRIBUTION_UNZIP_DIR="$MAVEN_WRAPPER_DIR/$DISTRIBUTION_NAME"
MAVEN_HOME="$DISTRIBUTION_UNZIP_DIR"

if [ ! -d "$MAVEN_HOME" ]; then
  DOWNLOAD_PATH="$MAVEN_WRAPPER_DIR/$DISTRIBUTION_FILE"
  echo "Downloading Maven from $DISTRIBUTION_URL"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$DOWNLOAD_PATH" "$DISTRIBUTION_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$DOWNLOAD_PATH" "$DISTRIBUTION_URL"
  else
    echo "ERROR: Neither curl nor wget is available. Please install Maven manually." >&2
    exit 1
  fi
  echo "Extracting Maven..."
  unzip -q "$DOWNLOAD_PATH" -d "$MAVEN_WRAPPER_DIR"
  rm -f "$DOWNLOAD_PATH"
  echo "Done."
fi

MVN_CMD="$MAVEN_HOME/bin/mvn"
if [ ! -x "$MVN_CMD" ]; then
  chmod +x "$MVN_CMD"
fi

exec "$MVN_CMD" "$@"
