# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=clinic_admin
POSTGRES_PASSWORD=clinic_secret
POSTGRES_PORT=5432
PLATFORM_DB_NAME=clinic_platform

# ── Spring Boot ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# ── JWT (minimum 256-bit / 32-char secret) ────────────────────
JWT_SECRET=change_this_to_a_256bit_secret_key_for_production_use
JWT_EXPIRATION_MS=86400000

# ── PII Encryption (AES-256-GCM) ─────────────────────────────
# Generate a production key: openssl rand -base64 32
PII_ENCRYPTION_KEY=change_this_to_a_base64_encoded_32byte_key

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=80

# ── CI/CD (set as GitHub Actions Secrets, not here) ──────────
# DEPLOY_HOST=your.server.ip
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=<private key>


export JWT_SECRET=$(openssl rand -base64 48)
export PII_ENCRYPTION_KEY=$(openssl rand -base64 32)
export PLATFORM_DB_URL=jdbc:postgresql://localhost:5432/clinic_platform
export PLATFORM_DB_USER=postgres
export PLATFORM_DB_PASSWORD=your_pg_password
export POSTGRES_ADMIN_USER=postgres
export POSTGRES_ADMIN_PASSWORD=your_pg_password
# These have defaults so optional:
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# POSTGRES_HOST=localhost  POSTGRES_PORT=5432
